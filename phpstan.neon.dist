includes:
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    level: 5
    bootstrapFiles:
        - phpstan/laravel-helpers.php
    paths:
        - src
    excludePaths:
        - src/MTProto/resources
    filesRootDir: %rootDir%/../../..
    disallowedFunctionCalls:
        -
            function: 'preg_*()'
            message: 'src/ is regex-free by spec 2026-08-28 §A — use sscanf/string functions/the TL tokenizer'
            allowIn:
                - bin/*
                - examples/*
        # Subprocess spawning is bin-only by policy. Exemption: SchemaAuditCommand
        # is a dev-only artisan command that invokes the bin/ generators
        # (php bin/generate-*.php) to audit the committed artifacts — the
        # generators themselves stay in bin/; this command only orchestrates.
        -
            function: 'proc_open()'
            message: 'subprocess spawning is bin-only by policy — move it into a bin/ generator; src/ orchestrates, not spawns'
            allowIn:
                - bin/*
                - examples/*
                - src/Console/SchemaAuditCommand.php
